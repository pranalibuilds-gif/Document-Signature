DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/signature_db
# Optional. Alembic falls back to DATABASE_URL when omitted.
# Production should use a dedicated migration role here and a least-privilege
# runtime role in DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql+psycopg://signature_migrator:replace-me@host:5432/signature_db
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ENVIRONMENT=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUST_PROXY_HEADERS=false
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_BASE_URL=http://localhost:5173
SIGNING_LINK_EXPIRE_HOURS=168
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage_data
# For AWS S3 or Supabase S3-compatible storage, set STORAGE_BACKEND=s3 or
# STORAGE_BACKEND=supabase and provide the bucket. AWS may use its instance-role
# credential chain; Supabase requires the S3 Access Key and Secret.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@example.com
# Required only when EMAIL_BACKEND=resend
RESEND_API_KEY=

# Production overrides (replace every example value):
# ENVIRONMENT=production
# TRUST_PROXY_HEADERS=true
# CORS_ALLOWED_ORIGINS=["https://your-frontend.example"]
# FRONTEND_BASE_URL=https://your-frontend.example
# STORAGE_BACKEND=s3
# EMAIL_BACKEND=resend
